@startuml
!theme plain
skinparam componentStyle uml2
skinparam linetype ortho
hide empty members

' --- COMANDO FONDAMENTALE PER IL FIX ---
allow_mixing

title GeoMAS: Low-Level Component & Module Structure

package "pkg: agents" {
    component "agent_cabinet.py" as Cabinet {
        class President
    }

    component "ministers.py" as Ministers {
        interface "IMinister" as IMin
        class DefenseMinister
        class EconomyMinister
        class ForeignMinister
    }

    component "advisors.py" as Advisors {
        class SciPySolver
        class OpinionSampler
    }

    component "public_opinion.py" as PubOp
}

package "pkg: world" {
    component "map_engine.py" as MapEng {
        class VoronoiGenerator
    }

    component "world_state.py" as State {
        class WorldState
        class TrustMatrix
    }

    component "rules_engine.py" as Rules {
        interface "IRulesOracle" as IRules
    }
}

package "pkg: shared" {
    component "schemas.py" as Schemas {
        class DiplomaticEnvelope
        class NationState
        class ProvinceState
    }

    component "actions_registry.py" as ActionReg
}

package "pkg: external" {
    component "llm_client.py" as LLM {
        interface "ILLMClient" as ILLM
    }
}

' --- RELAZIONI E DIPENDENZE ---

' 1. Agents Structure
Cabinet ..> IMin : manages
Ministers --|> IMin
Ministers ..> Advisors : uses
PubOp ..> Advisors : uses OpinionSampler
Cabinet ..> ILLM : uses for decisions

' 2. Shared Data Usage
Cabinet ..> Schemas : produces Envelope
Rules ..> Schemas : validates Envelope
State ..> Schemas : stores States

' 3. World Interaction
MapEng --> State : initializes
Rules --> State : reads/writes
Rules ..> ActionReg : looks up payloads

' 4. Agent to World Interface
Cabinet ..> IRules : sends Action
Rules -up-|> IRules

@enduml