@startuml
!theme plain
hide empty members
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam defaultTextAlignment center

' --- DEFINIZIONE LAYERS ---

package "1. Presentation" {
    component "Dashboard" as Dash
}

package "2. Explainability" {
    component "XAI Oracle" as XAI
    component "Counterfactual Engine" as Counter
}

package "3. Simulation" {
    component "Genesis\n(Initialization)" as Gen

    component "Spatial World Engine" as World {
        rectangle "Voronoi Topology"
        rectangle "Resource State"
    }

    component "Deterministic Rules Oracle" as Rules {
        rectangle "Topological Checker"
        rectangle "Constraint Validator"
        rectangle "Diplomatic Hard-Locks"
    }

    database "Structured Log Repository\n(JSON/SQLite)" as DB
}

package "4. Agents" {
    portin "Sense"
    portout "Act"

    rectangle "Country" {
        component "Ministers (Advisory)" as Min {
            rectangle "Defense"
            rectangle "Economy"
            rectangle "Foreign"
        }

        component "President (Executive)" as Pres
        component "Public Opinion (Constraint)" as PubOp
    }
}

cloud "Azure OpenAI\n(LLM Service)" as LLM

' --- RELAZIONI ---

' 1. Presentation Flow
Dash --> Gen : Config seed
Dash --> XAI

' 2. Explainability Flow
XAI --> DB : Retrieve
XAI -> Counter : Fork simulation
Counter --> Rules : Test counterfactual

' 3. Simulation Flow
Gen --> World : Init world
World -> DB : Update state / Saves world snapshot
Rules -> World : Modify world state
Rules -> DB : Store validation

' 4. Agent Sense Flow
World --> "Sense" : Spatial abstraction and resource state
' Nota: Mantengo il link al DB come memoria storica implicita o esplicita
DB .up.> "Sense" : History / Episodic Memory
"Sense" --> Min : Context distribution

' 5. Agent Cognitive Flow (LLM Interaction)
Min -> LLM : Generate three proposals
Min --> Pres : Three proposals

PubOp -> LLM : Generate internal poll (sampling)
PubOp -> Pres : Polling data / Internal call

Pres -> LLM : **Choose strategy for current turn**

' 6. Agent Act Flow
Pres -> "Act" : Generate diplomatic envelope
"Act" -> Rules : Validate envelope

' 7. Logging
"Country" -> DB : Store cabinet debate / History

@enduml